<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main">

    <!-- Primary Screen Layout -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Title Bar (OEM Holo Styling) -->
        <RelativeLayout
            android:id="@+id/title_bar"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="#16191b"
            android:paddingLeft="24dp"
            android:paddingRight="16dp">

            <!-- Title & Subtitle Left -->
            <LinearLayout
                android:id="@+id/title_left_group"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_alignParentLeft="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/txt_app_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="@color/white"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txt_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="14dp"
                    android:background="#202528"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:text="@string/nemesis_badge"
                    android:textColor="@color/text_title"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Status Pills & Close Right -->
            <LinearLayout
                android:id="@+id/title_right_group"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_alignParentRight="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/pill_daemon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill_daemon"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"
                    android:text="@string/daemon_running"
                    android:textColor="@color/accent_green"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/pill_gear"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:background="@drawable/bg_pill_gear"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"
                    android:text="@string/gear_park"
                    android:textColor="@color/accent_blue"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/pill_profile"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:background="@drawable/bg_pill_profile"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"
                    android:text="@string/active_driver_1"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/btn_close"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_marginLeft="14dp"
                    android:background="@null"
                    android:contentDescription="Close"
                    android:src="@drawable/co_btn_close_nor" />
            </LinearLayout>
        </RelativeLayout>

        <!-- Divider Line -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/border" />

        <!-- Main Body (2 Columns Split) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:paddingTop="12dp"
            android:paddingBottom="10dp">

            <!-- Left Panel: Paired Phones (flex 1.15) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginRight="12dp"
                android:layout_weight="1.15"
                android:background="@drawable/bg_panel"
                android:orientation="vertical">

                <!-- Panel Header -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:background="#1f2427"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:text="@string/section_paired_phones"
                        android:textColor="@color/text_title_bright"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentRight="true"
                        android:layout_centerVertical="true"
                        android:text="@string/subtitle_paired_phones"
                        android:textColor="@color/text_muted"
                        android:textSize="12sp" />
                </RelativeLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/border" />

                <!-- Phone List ScrollView -->
                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:padding="8dp">

                    <LinearLayout
                        android:id="@+id/phone_list_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- Phone 1: Pixel 11 Pro XL -->
                        <RelativeLayout
                            android:id="@+id/row_phone_1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:background="@drawable/bg_phone_row"
                            android:clickable="true"
                            android:focusable="true"
                            android:padding="12dp">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentLeft="true"
                                android:orientation="vertical">

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <TextView
                                        android:id="@+id/name_phone_1"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Pixel 11 Pro XL"
                                        android:textColor="@color/white"
                                        android:textSize="18sp"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:id="@+id/badge_phone_1"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginLeft="10dp"
                                        android:background="@drawable/badge_active"
                                        android:paddingLeft="8dp"
                                        android:paddingRight="8dp"
                                        android:paddingTop="2dp"
                                        android:paddingBottom="2dp"
                                        android:text="● BT + Wi-Fi Active"
                                        android:textColor="@color/accent_green"
                                        android:textSize="11sp"
                                        android:textStyle="bold" />
                                </LinearLayout>

                                <TextView
                                    android:id="@+id/meta_phone_1"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:text="BT: AA:BB:CC:11:22:33 · Wi-Fi: Learned (02:00:00:11:22:33) · Driver 1 #1"
                                    android:textColor="@color/accent_blue"
                                    android:textSize="12sp" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/tag_phone_1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentRight="true"
                                android:layout_centerVertical="true"
                                android:background="@drawable/tag_driver1"
                                android:paddingLeft="12dp"
                                android:paddingRight="12dp"
                                android:paddingTop="6dp"
                                android:paddingBottom="6dp"
                                android:text="Driver 1"
                                android:textColor="@color/white"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                        </RelativeLayout>

                        <!-- Phone 2: iPhone Duo -->
                        <RelativeLayout
                            android:id="@+id/row_phone_2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:background="@drawable/bg_phone_row"
                            android:clickable="true"
                            android:focusable="true"
                            android:padding="12dp">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentLeft="true"
                                android:orientation="vertical">

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <TextView
                                        android:id="@+id/name_phone_2"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="iPhone Duo"
                                        android:textColor="@color/white"
                                        android:textSize="18sp"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:id="@+id/badge_phone_2"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginLeft="10dp"
                                        android:background="@drawable/badge_paired"
                                        android:paddingLeft="8dp"
                                        android:paddingRight="8dp"
                                        android:paddingTop="2dp"
                                        android:paddingBottom="2dp"
                                        android:text="Paired"
                                        android:textColor="@color/text_secondary"
                                        android:textSize="11sp"
                                        android:textStyle="bold" />
                                </LinearLayout>

                                <TextView
                                    android:id="@+id/meta_phone_2"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:text="BT: DD:EE:FF:44:55:66 · Wi-Fi: Learned (02:00:00:44:55:66) · Driver 2 #2"
                                    android:textColor="@color/accent_amber"
                                    android:textSize="12sp" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/tag_phone_2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentRight="true"
                                android:layout_centerVertical="true"
                                android:background="@drawable/tag_driver2"
                                android:paddingLeft="12dp"
                                android:paddingRight="12dp"
                                android:paddingTop="6dp"
                                android:paddingBottom="6dp"
                                android:text="Driver 2"
                                android:textColor="@color/white"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                        </RelativeLayout>

                        <!-- Phone 3: Samsung S26 Ultra -->
                        <RelativeLayout
                            android:id="@+id/row_phone_3"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:background="@drawable/bg_phone_row"
                            android:clickable="true"
                            android:focusable="true"
                            android:padding="12dp">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentLeft="true"
                                android:orientation="vertical">

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <TextView
                                        android:id="@+id/name_phone_3"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Samsung S26 Ultra"
                                        android:textColor="@color/white"
                                        android:textSize="18sp"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:id="@+id/badge_phone_3"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginLeft="10dp"
                                        android:background="@drawable/badge_paired"
                                        android:paddingLeft="8dp"
                                        android:paddingRight="8dp"
                                        android:paddingTop="2dp"
                                        android:paddingBottom="2dp"
                                        android:text="Paired"
                                        android:textColor="@color/text_secondary"
                                        android:textSize="11sp"
                                        android:textStyle="bold" />
                                </LinearLayout>

                                <TextView
                                    android:id="@+id/meta_phone_3"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:text="BT: 11:22:33:AA:BB:CC · Wi-Fi: Unmapped · Ignored"
                                    android:textColor="@color/text_muted"
                                    android:textSize="12sp" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/tag_phone_3"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentRight="true"
                                android:layout_centerVertical="true"
                                android:background="@drawable/tag_ignored"
                                android:paddingLeft="12dp"
                                android:paddingRight="12dp"
                                android:paddingTop="6dp"
                                android:paddingBottom="6dp"
                                android:text="Ignored"
                                android:textColor="@color/text_muted"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                        </RelativeLayout>

                    </LinearLayout>
                </ScrollView>

                <!-- Tip Card at Bottom of Left Panel -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#16191b"
                    android:padding="10dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:lineSpacingExtra="2dp"
                        android:text="@string/tip_autolearn"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Right Panel: Settings (flex 0.85) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginLeft="12dp"
                android:layout_weight="0.85"
                android:background="@drawable/bg_panel"
                android:orientation="vertical">

                <!-- Panel Header -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:background="#1f2427"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:text="@string/section_settings"
                        android:textColor="@color/text_title_bright"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentRight="true"
                        android:layout_centerVertical="true"
                        android:text="@string/subtitle_settings"
                        android:textColor="@color/text_muted"
                        android:textSize="12sp" />
                </RelativeLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/border" />

                <!-- Settings ScrollView -->
                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- Setting 1: Auto-select -->
                        <CheckBox
                            android:id="@+id/chk_autoselect"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="@string/setting_autoselect"
                            android:textColor="@color/white"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="14dp"
                            android:layout_marginLeft="32dp"
                            android:text="@string/setting_autoselect_desc"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />

                        <!-- Setting 2: Dismiss Startup Notice (Opt-in) -->
                        <CheckBox
                            android:id="@+id/chk_dismiss"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:checked="false"
                            android:text="@string/setting_dismiss"
                            android:textColor="@color/white"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="14dp"
                            android:layout_marginLeft="32dp"
                            android:text="@string/setting_dismiss_desc"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />

                        <!-- Setting 3: Show Banner -->
                        <CheckBox
                            android:id="@+id/chk_banner"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="@string/setting_banner"
                            android:textColor="@color/white"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="16dp"
                            android:layout_marginLeft="32dp"
                            android:text="@string/setting_banner_desc"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />

                        <!-- Dropdown 1: Conflict Resolution -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp"
                            android:text="@string/label_conflict"
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp" />

                        <Spinner
                            android:id="@+id/spinner_conflict"
                            android:layout_width="match_parent"
                            android:layout_height="42dp"
                            android:layout_marginBottom="14dp"
                            android:background="#22272b" />

                        <!-- Dropdown 2: Detection Window -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp"
                            android:text="@string/label_window"
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp" />

                        <Spinner
                            android:id="@+id/spinner_window"
                            android:layout_width="match_parent"
                            android:layout_height="42dp"
                            android:background="#22272b" />

                    </LinearLayout>
                </ScrollView>
            </LinearLayout>
        </LinearLayout>

        <!-- Divider Line -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/border" />

        <!-- Bottom Action Bar -->
        <LinearLayout
            android:id="@+id/bottom_bar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="#16191b"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_refresh_phones"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginRight="14dp"
                android:background="@drawable/bg_btn_action"
                android:paddingLeft="18dp"
                android:paddingRight="18dp"
                android:text="@string/btn_refresh"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_test_driver1"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginRight="14dp"
                android:background="@drawable/bg_btn_action"
                android:paddingLeft="18dp"
                android:paddingRight="18dp"
                android:text="@string/btn_test_d1"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_test_driver2"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:background="@drawable/bg_btn_action"
                android:paddingLeft="18dp"
                android:paddingRight="18dp"
                android:text="@string/btn_test_d2"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- In-App Toast Banner Overlay -->
    <LinearLayout
        android:id="@+id/toast_banner_overlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="74dp"
        android:background="@drawable/bg_dialog_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="12dp"
        android:paddingLeft="20dp"
        android:paddingRight="24dp"
        android:paddingTop="12dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginRight="14dp"
            android:src="@drawable/ic_check" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/toast_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/accent_green"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/toast_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Profile switched to Driver 1"
                android:textColor="@color/white"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Modal Scrim 1: Warning Opt-in Dialog -->
    <FrameLayout
        android:id="@+id/modal_warning_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/scrim_bg"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="600dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bg_dialog_card"
            android:orientation="vertical"
            android:padding="20dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dialog_warning_title"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/btn_warning_dialog_close"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_alignParentRight="true"
                    android:background="@null"
                    android:src="@drawable/co_btn_close_nor" />
            </RelativeLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:lineSpacingExtra="3dp"
                android:text="@string/dialog_warning_body"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:background="@drawable/bg_warning_box"
                android:padding="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="3dp"
                    android:text="@string/dialog_warning_box"
                    android:textColor="@color/accent_amber"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="right"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_warning_confirm"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginRight="10dp"
                    android:background="@drawable/bg_btn_action"
                    android:paddingLeft="18dp"
                    android:paddingRight="18dp"
                    android:text="@string/btn_enable"
                    android:textColor="@color/accent_green"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btn_warning_cancel"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_btn_action"
                    android:paddingLeft="18dp"
                    android:paddingRight="18dp"
                    android:text="@string/btn_cancel"
                    android:textColor="@color/white"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- Modal Scrim 2: Assign Phone Dialog -->
    <FrameLayout
        android:id="@+id/modal_assign_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/scrim_bg"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="620dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bg_dialog_card"
            android:orientation="vertical"
            android:padding="20dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/assign_dialog_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dialog_assign_title"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/btn_assign_dialog_close"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_alignParentRight="true"
                    android:background="@null"
                    android:src="@drawable/co_btn_close_nor" />
            </RelativeLayout>

            <TextView
                android:id="@+id/assign_dialog_meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="BT: AA:BB:CC:11:22:33 · Wi-Fi: 02:00:00:11:22:33"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <!-- Option 1: Driver 1 -->
            <Button
                android:id="@+id/opt_assign_driver1"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_phone_row"
                android:gravity="left|center_vertical"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:text="Driver 1 (Priority #1)                 Primary Driver"
                android:textColor="@color/accent_blue"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- Option 2: Driver 2 -->
            <Button
                android:id="@+id/opt_assign_driver2"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_phone_row"
                android:gravity="left|center_vertical"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:text="Driver 2 (Priority #2)                 Secondary Driver"
                android:textColor="@color/accent_amber"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- Option 3: Ignored -->
            <Button
                android:id="@+id/opt_assign_ignore"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="18dp"
                android:background="@drawable/bg_phone_row"
                android:gravity="left|center_vertical"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:text="Do Not Assign (Ignored)               Ignore phone"
                android:textColor="@color/text_muted"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btn_assign_close_action"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_gravity="right"
                android:background="@drawable/bg_btn_action"
                android:paddingLeft="20dp"
                android:paddingRight="20dp"
                android:text="@string/btn_close"
                android:textColor="@color/white"
                android:textSize="14sp" />
        </LinearLayout>
    </FrameLayout>

</FrameLayout>
